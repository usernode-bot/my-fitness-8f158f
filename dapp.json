{
  "secrets": [
    {
      "key": "USDA_FDC_API_KEY",
      "description": "USDA FoodData Central API key, free from https://fdc.nal.usda.gov/api-key-signup. Enables USDA results in food search.",
      "required": false,
      "private": true
    }
  ],
  "permissions": [
    {
      "capability": "camera",
      "reason": "Scan food barcodes with your camera"
    }
  ],
  "tests": [
    {
      "id": "start.page",
      "name": "Start page renders",
      "path": "/",
      "expectSelector": "#start",
      "expectText": "Get started",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "calculations.js",
        "tailwind.config.js"
      ]
    },
    {
      "id": "onboarding.wizard",
      "name": "Onboarding wizard renders",
      "path": "/#profile",
      "expectSelector": "#wizard",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "calculations.js",
        "tailwind.config.js"
      ]
    },
    {
      "id": "dashboard.demo",
      "name": "Dashboard renders with demo plan",
      "path": "/?demo=1",
      "expectSelector": "#calorie-ring",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "calculations.js",
        "tailwind.config.js"
      ]
    },
    {
      "id": "food-search.demo",
      "name": "Add food opens at the meal step",
      "path": "/?demo=1#add",
      "expectSelector": "#add-wizard",
      "expectText": "Which meal",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    },
    {
      "id": "food-find.demo",
      "name": "Find-food step shows demo results",
      "path": "/?demo=1#add/find",
      "expectSelector": "#add-results",
      "expectText": "Staging demo oat bowl",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    },
    {
      "id": "create-food.demo",
      "name": "Create food opens at name and serving step",
      "path": "/?demo=1#add/find/create",
      "expectSelector": "#create-food-form",
      "expectText": "Name and serving",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    },
    {
      "id": "water-sheet.demo",
      "name": "Water log sheet opens over Food log",
      "path": "/?demo=1#log/water",
      "expectSelector": "#water-sheet",
      "expectText": "Log water",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    },
    {
      "id": "food-log.demo",
      "name": "Food log Today shows demo meals",
      "path": "/?demo=1#log",
      "expectSelector": "#log-meals",
      "expectText": "Staging demo oat bowl",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    },
    {
      "id": "food-history.demo",
      "name": "Food log Week shows demo history",
      "path": "/?demo=1#log/week",
      "expectSelector": "#log-history",
      "expectText": "Average calories",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "foods.js",
        "dapp.json",
        "tailwind.config.js"
      ]
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "💪"
  }
}
